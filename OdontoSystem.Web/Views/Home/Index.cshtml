@{
    ViewBag.Title = "Inicio";
}

<div class="container-fluid px-4 mt-4">
    <div class="mb-1">
        <h2 class="mb-0">Bienvenido, @Session["NombreCompleto"]</h2>
        <p class="text-muted mb-0 small">Panel principal del Consultorio Odontológico Romero</p>
    </div>

    @* Alerta de disponibilidad para odontólogos *@
    @if (ViewBag.AlertaDisponibilidad == true)
    {
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center gap-3 mt-3" role="alert">
            <i class="fa-solid fa-calendar-xmark fa-2x"></i>
            <div>
                <strong>No tienes disponibilidad registrada esta semana.</strong>
                Los pacientes no podrán agendar citas contigo hasta que registres tu horario.
                <a href="@Url.Action("Index", "Disponibilidad")" class="alert-link ms-2">
                    <i class="fa-solid fa-calendar-week"></i> Ir a Mi Calendario →
                </a>
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 mb-4 mt-1">
        <div class="col-md-6 col-lg-3">
            <div class="card kpi-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="kpi-icon"><i class="fa-solid fa-user-injured"></i></span>
                    </div>
                    <div class="kpi-label mb-1">Pacientes activos</div>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalPacientes</h2>
                    <a href="@Url.Action("Index","Pacientes")" class="text-decoration-none small mt-2 d-block">
                        Ver todos <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card kpi-card kpi-mint h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="kpi-icon"><i class="fa-solid fa-calendar-day"></i></span>
                    </div>
                    <div class="kpi-label mb-1">Citas hoy</div>
                    <h2 class="fw-bold mb-0">@ViewBag.CitasHoy</h2>
                    <a href="@Url.Action("Index","Citas")" class="text-decoration-none small mt-2 d-block">
                        Ver agenda <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card kpi-card kpi-amber h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="kpi-icon"><i class="fa-solid fa-clock"></i></span>
                    </div>
                    <div class="kpi-label mb-1">Citas pendientes</div>
                    <h2 class="fw-bold mb-0">@ViewBag.CitasPendientes</h2>
                    <a href="@Url.Action("Index","Citas")" class="text-decoration-none small mt-2 d-block">
                        Ver pendientes <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card kpi-card kpi-coral h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="kpi-icon"><i class="fa-solid fa-list-check"></i></span>
                    </div>
                    <div class="kpi-label mb-1">Tratamientos</div>
                    <h2 class="fw-bold mb-0">@ViewBag.Tratamientos</h2>
                    <a href="@Url.Action("Index","Catalogo")" class="text-decoration-none small mt-2 d-block">
                        Ver catálogo <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fa-solid fa-bolt text-warning"></i> Accesos rápidos
                    </h5>
                    <div class="d-grid gap-2 mt-3">
                        <a href="@Url.Action("Crear","Pacientes")" class="btn btn-outline-primary text-start">
                            <i class="fa-solid fa-user-plus me-2"></i> Registrar nuevo paciente
                        </a>
                        <a href="@Url.Action("Crear","Citas")" class="btn btn-outline-success text-start">
                            <i class="fa-solid fa-calendar-plus me-2"></i> Agendar nueva cita
                        </a>
                        <a href="@Url.Action("Index","Catalogo")" class="btn btn-outline-warning text-start">
                            <i class="fa-solid fa-list me-2"></i> Ver catálogo de tratamientos
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fa-solid fa-circle-info text-info"></i> Información del sistema
                    </h5>
                    <dl class="row mt-3 mb-0">
                        <dt class="col-5">Sistema</dt>
                        <dd class="col-7">OdontoSystem v1.0</dd>
                        <dt class="col-5">Usuario actual</dt>
                        <dd class="col-7">@Session["NombreCompleto"]</dd>
                        <dt class="col-5">Rol</dt>
                        <dd class="col-7"><span class="badge bg-primary">@Session["Rol"]</span></dd>
                        <dt class="col-5">Usuarios activos</dt>
                        <dd class="col-7">@ViewBag.TotalUsuarios</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

</div>