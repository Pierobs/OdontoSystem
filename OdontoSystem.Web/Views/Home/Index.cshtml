@{
    ViewBag.Title = "Inicio";
}

<div class="page-header">
    <div class="container">
        <h2 class="mb-0">
            <i class="fa-solid fa-tooth text-primary"></i>
            Bienvenido, @Session["NombreCompleto"]
        </h2>
        <p class="text-muted mb-0">Panel principal del Consultorio Odontológico Romero</p>
    </div>
</div>

<div class="container">
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card h-100" style="background: linear-gradient(135deg, #2563eb, #3b82f6);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="opacity-75 mb-1">Pacientes activos</h6>
                            <h2 class="fw-bold mb-0">@ViewBag.TotalPacientes</h2>
                        </div>
                        <i class="fa-solid fa-user-injured fa-2x opacity-50"></i>
                    </div>
                    <a href="@Url.Action("Index","Pacientes")" class="text-white text-decoration-none small mt-3 d-block">
                        Ver todos <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100" style="background: linear-gradient(135deg, #059669, #10b981);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="opacity-75 mb-1">Citas hoy</h6>
                            <h2 class="fw-bold mb-0">@ViewBag.CitasHoy</h2>
                        </div>
                        <i class="fa-solid fa-calendar-day fa-2x opacity-50"></i>
                    </div>
                    <a href="@Url.Action("Index","Citas")" class="text-white text-decoration-none small mt-3 d-block">
                        Ver agenda <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100" style="background: linear-gradient(135deg, #d97706, #f59e0b);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="opacity-75 mb-1">Citas pendientes</h6>
                            <h2 class="fw-bold mb-0">@ViewBag.CitasPendientes</h2>
                        </div>
                        <i class="fa-solid fa-clock fa-2x opacity-50"></i>
                    </div>
                    <a href="@Url.Action("Index","Citas")" class="text-white text-decoration-none small mt-3 d-block">
                        Ver pendientes <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100" style="background: linear-gradient(135deg, #7c3aed, #a78bfa);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="opacity-75 mb-1">Tratamientos</h6>
                            <h2 class="fw-bold mb-0">@ViewBag.Tratamientos</h2>
                        </div>
                        <i class="fa-solid fa-list-check fa-2x opacity-50"></i>
                    </div>
                    <a href="@Url.Action("Index","Catalogo")" class="text-white text-decoration-none small mt-3 d-block">
                        Ver catálogo <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fa-solid fa-bolt text-warning"></i> Accesos rápidos
                    </h5>
                    <div class="d-grid gap-2 mt-3">
                        <a href="@Url.Action("Crear","Pacientes")" class="btn btn-outline-primary text-start">
                            <i class="fa-solid fa-user-plus me-2"></i> Registrar nuevo paciente
                        </a>
                        <a href="@Url.Action("Crear","Citas")" class="btn btn-outline-success text-start">
                            <i class="fa-solid fa-calendar-plus me-2"></i> Agendar nueva cita
                        </a>
                        <a href="@Url.Action("Index","Catalogo")" class="btn btn-outline-warning text-start">
                            <i class="fa-solid fa-list me-2"></i> Ver catálogo de tratamientos
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fa-solid fa-circle-info text-info"></i> Información del sistema
                    </h5>
                    <dl class="row mt-3 mb-0">
                        <dt class="col-5">Sistema</dt>
                        <dd class="col-7">OdontoSystem v1.0</dd>
                        <dt class="col-5">Usuario actual</dt>
                        <dd class="col-7">@Session["NombreCompleto"]</dd>
                        <dt class="col-5">Rol</dt>
                        <dd class="col-7"><span class="badge bg-primary">@Session["Rol"]</span></dd>
                        <dt class="col-5">Usuarios activos</dt>
                        <dd class="col-7">@ViewBag.TotalUsuarios</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>