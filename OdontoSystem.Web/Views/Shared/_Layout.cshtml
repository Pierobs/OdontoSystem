<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>@ViewBag.Title - OdontoSystem</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />

    <style>
        /* ===== Tokens: sidebar claro estilo dashboard clínico moderno ===== */
        :root {
            --ink-900: #16323F;
            --ink-800: #1F4E5C;
            --ink-700: #2A6373;
            --blue-accent: #2C6ECB;
            --blue-accent-bg: #EAF1FC;
            --coral: #E2643B;
            --coral-600: #C94F29;
            --coral-bg: #FCEEE9;
            --mint: #2FA88F;
            --mint-600: #22876F;
            --mint-bg: #E8F6F2;
            --amber: #C98A2C;
            --amber-bg: #FBF3E4;
            --bg: #EEF3F8;
            --surface: #FFFFFF;
            --line: #E4E9EF;
            --text: #1B2A30;
            --text-muted: #6B7C87;
            --sidebar-w: 244px;
            --font-display: 'Space Grotesk', 'Segoe UI', sans-serif;
            --font-body: 'Inter', 'Segoe UI', sans-serif;
            --font-mono: 'IBM Plex Mono', 'Consolas', monospace;
            --bs-primary: var(--blue-accent);
            --bs-primary-rgb: 44, 110, 203;
            --bs-success: var(--mint);
            --bs-success-rgb: 47, 168, 143;
            --bs-danger: var(--coral-600);
            --bs-danger-rgb: 201, 79, 41;
            --bs-warning: var(--amber);
            --bs-warning-rgb: 201, 138, 44;
            --bs-info: var(--ink-700);
            --bs-info-rgb: 42, 99, 115;
            --bs-body-font-family: var(--font-body);
            --bs-border-radius: .5rem;
            --bs-border-radius-lg: .625rem;
            --bs-border-radius-sm: .375rem;
        }

        body {
            background: var(--bg);
            font-family: var(--font-body);
            color: var(--text);
        }

        h1, h2, h3, h4, h5, h6, .card-title {
            font-family: var(--font-display);
            letter-spacing: -0.01em;
        }

        .num, td.text-end, .table td:has(> .num) {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
        }

        /* ===== Sidebar claro ===== */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--sidebar-w);
            background: var(--surface);
            border-right: 1px solid var(--line);
            display: flex;
            flex-direction: column;
            z-index: 1030;
            transition: transform .2s ease;
            overflow-y: auto;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px 20px 16px;
            color: var(--ink-900);
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.1rem;
            border-bottom: 1px solid var(--line);
            text-decoration: none;
        }

            .sidebar-brand i {
                color: var(--coral);
                font-size: 1.15rem;
            }

        .sidebar-group {
            padding: 18px 18px 6px;
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .07em;
            text-transform: uppercase;
            color: #9AA7B0;
        }

        .sidebar-nav {
            list-style: none;
            margin: 0;
            padding: 4px 12px;
        }

            .sidebar-nav .nav-link {
                display: flex;
                align-items: center;
                gap: 10px;
                color: var(--text-muted) !important;
                font-weight: 500;
                font-size: .89rem;
                padding: 9px 12px !important;
                border-radius: .5rem;
                margin-bottom: 2px;
                transition: background .15s, color .15s;
            }

                .sidebar-nav .nav-link i {
                    width: 18px;
                    text-align: center;
                    color: #9AA7B0;
                }

                .sidebar-nav .nav-link:hover {
                    background: #F4F7FA;
                    color: var(--ink-900) !important;
                }

                .sidebar-nav .nav-link.active {
                    background: var(--blue-accent-bg);
                    color: var(--blue-accent) !important;
                    font-weight: 600;
                }

                    .sidebar-nav .nav-link.active i {
                        color: var(--blue-accent);
                    }

        .sidebar-footer {
            margin-top: auto;
            padding: 14px;
            border-top: 1px solid var(--line);
        }

        .user-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #F6F8FA;
            border: 1px solid var(--line);
            padding: 8px 12px;
            border-radius: .5rem;
            color: var(--ink-900);
            font-size: 0.82rem;
            margin-bottom: 8px;
        }

            .user-badge i {
                color: var(--mint);
                font-size: 1.1rem;
            }

            .user-badge .role {
                display: block;
                font-size: .72rem;
                color: var(--text-muted);
            }

        .sidebar-footer .btn-key, .sidebar-footer .btn-logout {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-size: .8rem;
            padding: 6px 10px;
            border-radius: .5rem;
            text-decoration: none;
            transition: all .15s;
            flex: 1;
            background: var(--surface);
            border: 1px solid var(--line);
            color: var(--text-muted);
        }

            .sidebar-footer .btn-key:hover {
                background: #F4F7FA;
                color: var(--ink-900);
            }

            .sidebar-footer .btn-logout:hover {
                background: var(--coral-bg);
                border-color: var(--coral);
                color: var(--coral-600);
            }

        .sidebar-footer .row-actions {
            display: flex;
            gap: 6px;
        }

        .sidebar-toggle {
            display: none;
            position: fixed;
            top: 14px;
            left: 14px;
            z-index: 1040;
            background: var(--surface);
            color: var(--ink-900);
            border: 1px solid var(--line);
            width: 40px;
            height: 40px;
            border-radius: .5rem;
            font-size: 1.1rem;
        }

        .main-wrap {
            margin-left: var(--sidebar-w);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

            .main-wrap.no-sidebar {
                margin-left: 0;
            }

        @@media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main-wrap {
                margin-left: 0;
            }

            .sidebar-toggle {
                display: block;
            }
        }

        .footer {
            background: var(--surface);
            color: var(--text-muted);
            border-top: 1px solid var(--line);
            padding: 16px 0;
            text-align: center;
            margin-top: auto;
            font-size: 0.85rem;
        }

        .page-header {
            background: transparent;
            padding: 4px 0 18px;
            margin-bottom: 8px;
        }

            .page-header h2 {
                color: var(--ink-900);
            }

        .table thead th {
            background: transparent;
            color: var(--text-muted);
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 0.76rem;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            border-bottom: 1px solid var(--line);
            padding-bottom: 10px;
        }

        .table tbody tr {
            transition: background 0.12s;
        }

            .table tbody tr:hover {
                background: #F7F9FB !important;
            }

        .table tbody td {
            border-color: var(--line);
        }

        /* Badges como pills suaves (fondo tenue + texto de color), no bloque sólido */
        .badge {
            font-weight: 600;
            font-family: var(--font-body);
            padding: 5px 12px;
            font-size: 0.76rem;
            border-radius: 999px;
            letter-spacing: 0.01em;
        }

            .badge.bg-success {
                background: var(--mint-bg) !important;
                color: var(--mint-600) !important;
            }

            .badge.bg-warning {
                background: var(--amber-bg) !important;
                color: var(--amber) !important;
            }

            .badge.bg-danger {
                background: var(--coral-bg) !important;
                color: var(--coral-600) !important;
            }

            .badge.bg-secondary {
                background: #EEF1F4 !important;
                color: var(--text-muted) !important;
            }

            .badge.bg-primary {
                background: var(--blue-accent-bg) !important;
                color: var(--blue-accent) !important;
            }

        .btn-primary {
            background: var(--blue-accent);
            border-color: var(--blue-accent);
            font-weight: 500;
            transition: all 0.15s;
        }

            .btn-primary:hover {
                background: #235AAB;
                border-color: #235AAB;
                transform: translateY(-1px);
            }

        .form-control:focus, .form-select:focus {
            border-color: var(--blue-accent);
            box-shadow: 0 0 0 0.2rem rgba(44,110,203,0.15);
        }

        .card {
            border: 1px solid var(--line);
            border-radius: 1rem;
            box-shadow: 0 8px 24px rgba(16,42,52,0.08);
        }

        .card-body {
            padding: 1.75rem;
        }

        .table thead th {
            padding-bottom: 14px;
        }

        .table tbody td {
            padding-top: 14px;
            padding-bottom: 14px;
        }

        .kpi-card .kpi-icon {
            width: 38px;
            height: 38px;
            border-radius: .55rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            color: var(--text-muted);
            font-size: 1.05rem;
        }

        .kpi-card.kpi-mint .kpi-icon {
            color: var(--mint-600);
        }

        .kpi-card.kpi-amber .kpi-icon {
            color: var(--amber);
        }

        .kpi-card.kpi-coral .kpi-icon {
            color: var(--coral-600);
        }

        .kpi-card h2 {
            font-family: var(--font-mono);
            font-weight: 600;
            color: var(--ink-900);
        }

        .kpi-card .kpi-label {
            font-size: .78rem;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .03em;
        }

        .kpi-card a {
            color: var(--blue-accent) !important;
            font-weight: 500;
        }

        .avatar-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--blue-accent-bg);
            color: var(--blue-accent);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .74rem;
            font-weight: 700;
            font-family: var(--font-body);
            flex-shrink: 0;
        }
    </style>
</head>
<body>
    @{
        bool logueado = Session["IdUsuario"] != null;
        string rol = Session["Rol"]?.ToString();
        string controlador = ViewContext.RouteData.Values["controller"]?.ToString();
        Func<string, bool> esActivo = (c) => string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase);
    }

    @if (logueado)
    {
        <button class="sidebar-toggle" onclick="document.querySelector('.sidebar').classList.toggle('open')">
            <i class="fa-solid fa-bars"></i>
        </button>

        <nav class="sidebar">
            <a class="sidebar-brand" href="@Url.Action("Index", "Home")">
                <i class="fa-solid fa-tooth"></i> OdontoSystem
            </a>

            <div class="sidebar-group">Clínica</div>
            <ul class="sidebar-nav">
                <li><a class="nav-link @(esActivo("Home") ? "active" : "")" href="@Url.Action("Index","Home")"><i class="fa-solid fa-house"></i> Inicio</a></li>
                <li><a class="nav-link @(esActivo("Pacientes") ? "active" : "")" href="@Url.Action("Index","Pacientes")"><i class="fa-solid fa-user-injured"></i> Pacientes</a></li>
                <li><a class="nav-link @(esActivo("Citas") ? "active" : "")" href="@Url.Action("Index","Citas")"><i class="fa-solid fa-calendar-days"></i> Citas</a></li>
                <li><a class="nav-link @(esActivo("Catalogo") ? "active" : "")" href="@Url.Action("Index","Catalogo")"><i class="fa-solid fa-list-check"></i> Catálogo</a></li>
            </ul>

            @if (rol == "Odontologo" || rol == "Administrador")
            {
                <div class="sidebar-group">Gestión</div>
                <ul class="sidebar-nav">
                    <li><a class="nav-link @(esActivo("Planes") ? "active" : "")" href="@Url.Action("Index","Planes")"><i class="fa-solid fa-clipboard-list"></i> Planes</a></li>
                    <li><a class="nav-link @(esActivo("Disponibilidad") ? "active" : "")" href="@Url.Action("Index","Disponibilidad")"><i class="fa-solid fa-calendar-week"></i> Mi Calendario</a></li>
                </ul>
            }

            @if (rol == "Administrador")
            {
                <div class="sidebar-group">Administración</div>
                <ul class="sidebar-nav">
                    <li><a class="nav-link @(esActivo("Usuarios") ? "active" : "")" href="@Url.Action("Index","Usuarios")"><i class="fa-solid fa-users-gear"></i> Usuarios</a></li>
                </ul>
            }

            <div class="sidebar-footer">
                <div class="user-badge">
                    <i class="fa-solid fa-user-circle fa-lg"></i>
                    <span>
                        @Session["NombreCompleto"]
                        <small class="role">@rol</small>
                    </span>
                </div>
                <div class="row-actions">
                    <a class="btn-key" href="@Url.Action("CambiarMiPassword","Account")" title="Cambiar mi contraseña">
                        <i class="fa-solid fa-key"></i> Clave
                    </a>
                    <a class="btn-logout" href="@Url.Action("Logout","Account")">
                        <i class="fa-solid fa-right-from-bracket"></i> Salir
                    </a>
                </div>
            </div>
        </nav>
    }

    <div class="main-wrap @(logueado ? "" : "no-sidebar")">
        <main>
            @RenderBody()
        </main>

        <footer class="footer">
            <div class="container">
                <small>
                    © 2026 <strong>OdontoSystem</strong> — Consultorio Odontológico Romero —
                    Proyecto Tecnológico ISIL · NRC 6379
                </small>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
