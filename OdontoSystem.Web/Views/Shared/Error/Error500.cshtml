@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Error del servidor";
}

<div class="container text-center mt-5">
    <div style="font-size: 8rem; color: #dc2626; font-weight: bold; line-height: 1;">500</div>
    <h2 class="mt-3">Error interno del servidor</h2>
    <p class="text-muted">
        Lo sentimos, ocurrió un problema procesando tu solicitud.<br />
        El equipo técnico ha sido notificado automáticamente.
    </p>
    @if (ViewBag.CodigoError != null)
    {
        <p class="mt-3"><small class="text-muted">Código de error: <code>@ViewBag.CodigoError</code></small></p>
    }
    <div class="mt-4">
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
            <i class="fa-solid fa-house"></i> Volver al inicio
        </a>
        <button onclick="location.reload()" class="btn btn-outline-secondary">
            <i class="fa-solid fa-rotate"></i> Reintentar
        </button>
    </div>
</div>