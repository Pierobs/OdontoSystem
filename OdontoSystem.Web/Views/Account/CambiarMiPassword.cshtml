@{
    ViewBag.Title = "Cambiar mi contraseña";
    bool esObligatorio = ViewBag.EsObligatorio != null && (bool)ViewBag.EsObligatorio;
    int? diasParaExpiracion = ViewBag.DiasParaExpiracion as int?;
}

<div class="container mt-4" style="max-width: 600px;">

    @if (esObligatorio)
    {
        <div class="alert alert-danger">
            <h5><i class="fa-solid fa-triangle-exclamation"></i> Cambio de contraseña obligatorio</h5>
            <p class="mb-0">
                Por motivos de seguridad, debes cambiar tu contraseña antes de continuar.
                No podrás acceder a otras secciones hasta completar este paso.
            </p>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2><i class="fa-solid fa-key"></i> Cambiar mi contraseña</h2>
            <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">← Volver</a>
        </div>
    }

    @if (TempData["AvisoPassword"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            @TempData["AvisoPassword"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-primary text-white">
            <strong>Actualizar mi contraseña</strong>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <strong>Usuario:</strong> @Session["NombreCompleto"]<br />
                <strong>Correo:</strong> @Session["UsuarioCorreo"]
            </div>

            <form action="@Url.Action("CambiarMiPassword", "Account")" method="post" id="formPassword">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Contraseña actual *</label>
                    <input type="password" name="PasswordActual" id="inputActual"
                           class="form-control" required maxlength="50"
                           placeholder="Ingresa tu contraseña actual" />
                </div>

                <hr />

                <div class="mb-3">
                    <label class="form-label">Nueva contraseña *</label>
                    <div class="input-group">
                        <input type="password" name="NuevaPassword" id="inputNueva"
                               class="form-control" required minlength="6" maxlength="50" />
                        <button type="button" class="btn btn-outline-secondary" id="btnTogglePass">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <small class="text-muted">Mínimo 6 caracteres. No puede ser igual a la actual.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirmar nueva contraseña *</label>
                    <input type="password" id="inputConfirmar" class="form-control"
                           required minlength="6" maxlength="50" />
                    <small id="feedbackMatch" class="text-muted"></small>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success" id="btnGuardar" disabled>
                        <i class="fa-solid fa-floppy-disk"></i> Cambiar mi contraseña
                    </button>

                    @if (!esObligatorio)
                    {
                        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Cancelar</a>
                    }
                    else
                    {
                        <a href="@Url.Action("Logout", "Account")" class="btn btn-outline-danger">
                            <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const inputActual = document.getElementById('inputActual');
            const inputNueva = document.getElementById('inputNueva');
            const inputConf = document.getElementById('inputConfirmar');
            const feedback = document.getElementById('feedbackMatch');
            const btnGuardar = document.getElementById('btnGuardar');
            const btnToggle = document.getElementById('btnTogglePass');

            function validar() {
                const actual = inputActual.value;
                const nueva = inputNueva.value;
                const conf = inputConf.value;

                if (actual.length === 0) {
                    feedback.innerHTML = '<span class="text-secondary">Ingresa primero tu contraseña actual</span>';
                    btnGuardar.disabled = true;
                    return;
                }

                if (nueva.length < 6) {
                    feedback.innerHTML = '<span class="text-secondary">Mínimo 6 caracteres en la nueva contraseña</span>';
                    btnGuardar.disabled = true;
                    return;
                }

                if (nueva === actual) {
                    feedback.innerHTML = '<span class="text-danger">❌ La nueva contraseña no puede ser igual a la actual</span>';
                    btnGuardar.disabled = true;
                    return;
                }

                if (conf.length === 0) {
                    feedback.innerHTML = '';
                    btnGuardar.disabled = true;
                    return;
                }

                if (nueva !== conf) {
                    feedback.innerHTML = '<span class="text-danger">❌ Las contraseñas no coinciden</span>';
                    btnGuardar.disabled = true;
                    return;
                }

                feedback.innerHTML = '<span class="text-success">✅ Las contraseñas coinciden</span>';
                btnGuardar.disabled = false;
            }

            inputActual.addEventListener('input', validar);
            inputNueva.addEventListener('input', validar);
            inputConf.addEventListener('input', validar);

            btnToggle.addEventListener('click', function () {
                const tipo = inputNueva.type === 'password' ? 'text' : 'password';
                inputNueva.type = tipo;
                inputConf.type = tipo;
                this.querySelector('i').className = tipo === 'password' ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';
            });
        })();
    </script>
}