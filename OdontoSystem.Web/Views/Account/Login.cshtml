@{
    ViewBag.Title = "Inicio de sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OdontoSystem · Iniciar sesión</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --blue-accent: #2C6ECB;
            --blue-accent-2: #4E8FE0;
            --ink-900: #16323F;
            --coral: #E2643B;
            --coral-600: #C94F29;
            --mint: #2FA88F;
            --bg: #EEF3F8;
            --line: #E4E9EF;
            --text: #1B2A30;
            --text-muted: #6B7C87;
            --font-display: 'Space Grotesk', 'Segoe UI', sans-serif;
            --font-body: 'Inter', 'Segoe UI', sans-serif;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: var(--font-body);
            background: var(--bg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
            color: var(--text);
        }

        .login-wrap {
            width: 100%;
            max-width: 960px;
            min-height: 580px;
            background: #fff;
            border-radius: 1.25rem;
            overflow: hidden;
            display: flex;
            border: 1px solid var(--line);
            box-shadow: 0 12px 36px rgba(16,42,52,0.10);
        }

        /* === Lado izquierdo: ilustración === */
        .login-pic {
            flex: 1;
            background: linear-gradient(135deg, var(--ink-900) 0%, var(--blue-accent) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            position: relative;
            overflow: hidden;
        }

            .login-pic::before {
                content: '';
                position: absolute;
                width: 300px;
                height: 300px;
                background: rgba(255,255,255,0.06);
                border-radius: 50%;
                top: -100px;
                left: -100px;
            }

            .login-pic::after {
                content: '';
                position: absolute;
                width: 200px;
                height: 200px;
                background: rgba(226,100,59,0.18);
                border-radius: 50%;
                bottom: -80px;
                right: -50px;
            }

            .login-pic svg {
                width: 80%;
                max-width: 320px;
                position: relative;
                z-index: 1;
            }

        /* === Lado derecho: formulario === */
        .login-form {
            flex: 1;
            padding: 60px 55px 50px 55px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-form-title {
            font-family: var(--font-display);
            font-size: 26px;
            color: var(--ink-900);
            font-weight: 700;
            text-align: center;
            margin-bottom: 40px;
            letter-spacing: -0.01em;
        }

            .login-form-title span {
                color: var(--blue-accent);
            }

        .wrap-input {
            position: relative;
            border-bottom: 2px solid var(--line);
            margin-bottom: 28px;
            transition: border-color 0.2s;
        }

            .wrap-input.focus-input {
                border-bottom-color: var(--blue-accent);
            }

        .label-input {
            display: block;
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 4px;
            font-weight: 600;
        }

        .input-field {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            font-size: 16px;
            color: var(--text);
            padding: 4px 35px 8px 0;
            font-family: inherit;
        }

        .focus-icon {
            position: absolute;
            right: 0;
            bottom: 10px;
            color: var(--text-muted);
            font-size: 16px;
            transition: color 0.2s;
        }

        .wrap-input.focus-input .focus-icon {
            color: var(--blue-accent);
        }

        .btn-login {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: .625rem;
            background: var(--blue-accent);
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.15s, transform 0.15s;
            margin-top: 10px;
        }

            .btn-login:hover {
                background: #235AAB;
                transform: translateY(-1px);
            }

        .extra-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
            font-size: 13px;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
            cursor: pointer;
            margin: 0;
        }

        .extra-row a {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s;
        }

            .extra-row a:hover {
                color: var(--blue-accent);
            }

        .form-footer {
            text-align: center;
            margin-top: 28px;
            font-size: 14px;
            color: var(--text-muted);
        }

            .form-footer a {
                color: var(--blue-accent);
                font-weight: 600;
                text-decoration: none;
                margin-left: 5px;
            }

        .alert-custom {
            padding: 10px 15px;
            border-radius: .625rem;
            margin-bottom: 20px;
            font-size: 14px;
            text-align: center;
            font-weight: 500;
        }

        .alert-error {
            background: #FCEEE9;
            color: var(--coral-600);
            border: 1px solid #F3D3C6;
        }

        .alert-success {
            background: #E8F6F2;
            color: #22876F;
            border: 1px solid #C7E9DF;
        }

        @@media (max-width: 768px) {
            .login-wrap {
                flex-direction: column;
                min-height: auto;
            }

            .login-pic {
                padding: 30px;
                min-height: 160px;
            }

                .login-pic svg {
                    max-width: 120px;
                }

            .login-form {
                padding: 40px 30px;
            }

            .login-form-title {
                font-size: 21px;
                margin-bottom: 25px;
            }
        }
    </style>
</head>
<body>
    <div class="login-wrap">
        <div class="login-pic">
            <svg viewBox="0 0 200 220" xmlns="http://www.w3.org/2000/svg">
                <path d="M100 30 C 70 30, 50 55, 50 90 C 50 120, 60 160, 70 195 C 75 210, 90 210, 95 195 L 100 165 L 105 195 C 110 210, 125 210, 130 195 C 140 160, 150 120, 150 90 C 150 55, 130 30, 100 30 Z"
                      fill="#ffffff" />
                <ellipse cx="80" cy="70" rx="10" ry="20" fill="rgba(226,100,59,0.35)" />
                <circle cx="35" cy="50" r="3" fill="rgba(255,255,255,0.7)" />
                <circle cx="170" cy="80" r="4" fill="rgba(255,255,255,0.6)" />
                <circle cx="160" cy="40" r="2.5" fill="rgba(255,255,255,0.8)" />
                <circle cx="25" cy="160" r="3.5" fill="rgba(255,255,255,0.5)" />
            </svg>
        </div>

        <div class="login-form">
            <div class="login-form-title">
                Bienvenido a <span>OdontoSystem</span>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert-custom alert-error">
                    <i class="fa-solid fa-circle-exclamation me-1"></i> @TempData["Error"]
                </div>
            }
            @if (TempData["Exito"] != null)
            {
                <div class="alert-custom alert-success">
                    <i class="fa-solid fa-circle-check me-1"></i> @TempData["Exito"]
                </div>
            }

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="wrap-input">
                    <label class="label-input">Correo institucional</label>
                    <input class="input-field" type="email" name="correo" required autofocus />
                    <i class="focus-icon fa-solid fa-envelope"></i>
                </div>

                <div class="wrap-input">
                    <label class="label-input">Contraseña</label>
                    <input class="input-field" type="password" name="password" required />
                    <i class="focus-icon fa-solid fa-lock"></i>
                </div>

                <div class="extra-row">
                    <label class="remember-me">
                        <input type="checkbox" name="recordar" />
                        Recordarme
                    </label>
                    <a href="#">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="btn-login">
                    <i class="fa-solid fa-right-to-bracket me-2"></i> Ingresar
                </button>
            }
        </div>
    </div>

    <script>
        document.querySelectorAll('.input-field').forEach(input => {
            input.addEventListener('focus', () => input.closest('.wrap-input').classList.add('focus-input'));
            input.addEventListener('blur', () => input.closest('.wrap-input').classList.remove('focus-input'));
        });
    </script>
</body>
</html>
