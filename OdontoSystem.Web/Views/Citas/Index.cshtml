@model IEnumerable<OdontoSystem.Entities.Cita>

@{
    ViewBag.Title = "Citas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Citas Agendadas</h2>
        <a href="@Url.Action("Crear")" class="btn btn-primary">+ Nueva Cita</a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped">
            <thead class="table-primary">
                <tr>
                    <th>#</th>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Paciente</th>
                    <th>Odontólogo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.IdCita</td>
                        <td>@c.FechaCita.ToString("dd/MM/yyyy")</td>
                        <td>@c.HoraCita.ToString(@"hh\:mm")</td>
                        <td>@c.Paciente.ApellidoPaterno @c.Paciente.ApellidoMaterno, @c.Paciente.Nombres</td>
                        <td>Dr. @c.Odontologo.ApellidoPaterno @c.Odontologo.Nombres</td>
                        <td>
                            @switch (c.Estado)
                            {
                                case "Pendiente":<span class="badge bg-warning text-dark">Pendiente</span> break;
                                case "Atendida": <span class="badge bg-success">Atendida</span> break;
                                case "Cancelada": <span class="badge bg-danger">Cancelada</span>break;
                            }
                        </td>
                        <td>
                            @if (c.Estado == "Pendiente")
                            {
                                <a href="@Url.Action("Cancelar", new { id = c.IdCita })"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('¿Cancelar esta cita?');">
                                    Cancelar
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No hay citas agendadas.</div>
    }
</div>