@model OdontoSystem.Entities.Cita
@{
    ViewBag.Title = "Nueva Cita";
    var pacientes = (IEnumerable<OdontoSystem.Entities.Paciente>)ViewBag.Pacientes;
    var odontologos = (IEnumerable<OdontoSystem.Entities.Usuario>)ViewBag.Odontologos;
}

<div class="container mt-4">
    <h2>Agendar Nueva Cita</h2>
    <hr />

    <div class="alert alert-info" style="font-size: 0.9em;">
        <i class="fa-solid fa-circle-info"></i>
        <strong>Horario de atención:</strong> 09:00 a 19:00 en intervalos de 30 minutos.
        Capacidad: 2 citas en paralelo por horario.
    </div>

    @using (Html.BeginForm("Crear", "Citas", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Paciente *</label>
                <select name="IdPaciente" class="form-select" required>
                    <option value="">-- Seleccione paciente --</option>
                    @if (pacientes != null)
                    {
                        foreach (var p in pacientes)
                        {
                            <option value="@p.IdPaciente">@p.ApellidoPaterno @p.ApellidoMaterno, @p.Nombres</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Odontólogo *</label>
                <select name="IdOdontologo" id="selectOdontologo" class="form-select" required>
                    <option value="">-- Seleccione odontólogo --</option>
                    @if (odontologos != null)
                    {
                        foreach (var o in odontologos)
                        {
                            <option value="@o.IdUsuario">Dr. @o.ApellidoPaterno @o.Nombres</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Fecha *</label>
                <input type="date" name="FechaCita" id="inputFechaCita" class="form-control" required
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Hora *</label>
                <select name="HoraCita" id="selectHoraCita" class="form-select" required disabled>
                    <option value="">-- Seleccione primero una fecha --</option>
                </select>
                <small id="estadoSlots" class="text-muted"></small>
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <div id="feedbackCita" style="font-size: 0.9em;"></div>
            </div>

            <div class="col-12">
                <label class="form-label">Observaciones</label>
                <textarea name="Observaciones" class="form-control" rows="3" maxlength="500"></textarea>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success" id="btnAgendar">Agendar</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // ─── Validación y carga dinámica de horarios ────────────
        (function () {
            const inputFecha    = document.getElementById('inputFechaCita');
            const selectHora    = document.getElementById('selectHoraCita');
            const estadoSlots   = document.getElementById('estadoSlots');
            const feedback      = document.getElementById('feedbackCita');
            const btnAgendar    = document.getElementById('btnAgendar');

            inputFecha.addEventListener('change', function () {
                const fecha = this.value;
                selectHora.innerHTML = '<option value="">-- Cargando horarios... --</option>';
                selectHora.disabled = true;
                feedback.innerHTML = '';
                estadoSlots.innerHTML = '';

                if (!fecha) return;

                // Validar fecha no pasada
                const hoy = new Date();
                hoy.setHours(0, 0, 0, 0);
                const fechaSeleccionada = new Date(fecha + 'T00:00:00');

                if (fechaSeleccionada < hoy) {
                    feedback.innerHTML = '<span class="text-danger">❌ No se puede agendar en fechas pasadas</span>';
                    selectHora.innerHTML = '<option value="">-- Fecha inválida --</option>';
                    return;
                }

                // Cargar slots disponibles
                fetch('@Url.Action("SlotsDisponibles", "Citas")?fecha=' + fecha)
                    .then(function (res) { return res.json(); })
                    .then(function (slots) {
                        selectHora.innerHTML = '<option value="">-- Seleccione hora --</option>';
                        const esHoy = fechaSeleccionada.getTime() === hoy.getTime();
                        const horaActual = new Date();
                        let disponibles = 0;

                        slots.forEach(function (s) {
                            const [h, m] = s.hora.split(':').map(Number);
                            const horaSlot = new Date(fechaSeleccionada);
                            horaSlot.setHours(h, m, 0, 0);

                            // Si es hoy, ocultar slots ya pasados
                            const yaPaso = esHoy && horaSlot < horaActual;

                            const opt = document.createElement('option');
                            opt.value = s.hora;

                            if (yaPaso) {
                                opt.textContent = s.hora + ' — Hora pasada';
                                opt.disabled = true;
                            } else if (!s.disponible) {
                                opt.textContent = s.hora + ' — Ocupado (' + s.ocupados + '/2)';
                                opt.disabled = true;
                            } else {
                                opt.textContent = s.hora + ' — Libre (' + s.ocupados + '/2)';
                                disponibles++;
                            }

                            selectHora.appendChild(opt);
                        });

                        selectHora.disabled = false;
                        if (disponibles === 0) {
                            estadoSlots.innerHTML = '<span class="text-danger">⚠️ No hay horarios disponibles este día</span>';
                        } else {
                            estadoSlots.innerHTML = '<span class="text-success">✅ ' + disponibles + ' horario(s) disponible(s)</span>';
                        }
                    })
                    .catch(function () {
                        feedback.innerHTML = '<span class="text-danger">Error al cargar horarios</span>';
                        selectHora.innerHTML = '<option value="">-- Error --</option>';
                    });
            });

            // Validación antes de enviar
            document.querySelector('form').addEventListener('submit', function (e) {
                const fecha = inputFecha.value;
                const hora = selectHora.value;

                if (!fecha || !hora) return;

                // Validación final fecha/hora pasada
                const fechaHora = new Date(fecha + 'T' + hora);
                if (fechaHora < new Date()) {
                    e.preventDefault();
                    feedback.innerHTML = '<span class="text-danger">❌ No se puede agendar en el pasado</span>';
                    return;
                }
            });
        })();
    </script>
}