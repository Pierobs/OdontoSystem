@model OdontoSystem.Entities.Cita
@{
    ViewBag.Title = "Nueva Cita";
    var pacientes = (IEnumerable<OdontoSystem.Entities.Paciente>)ViewBag.Pacientes;
    var odontologos = (IEnumerable<OdontoSystem.Entities.Usuario>)ViewBag.Odontologos;
}

<div class="container mt-4">
    <h2>Agendar Nueva Cita</h2>
    <hr />

    <div class="alert alert-info" style="font-size: 0.9em;">
        <i class="fa-solid fa-circle-info"></i>
        <strong>Cómo agendar:</strong> Selecciona el odontólogo primero — solo verás las fechas y horarios donde tiene disponibilidad registrada.
    </div>

    @using (Html.BeginForm("Crear", "Citas", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Paciente *</label>
                <select name="IdPaciente" class="form-select" required>
                    <option value="">-- Seleccione paciente --</option>
                    @if (pacientes != null)
                    {
                        foreach (var p in pacientes)
                        {
                            <option value="@p.IdPaciente">@p.ApellidoPaterno @p.ApellidoMaterno, @p.Nombres</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Odontólogo *</label>
                <select name="IdOdontologo" id="selectOdontologo" class="form-select" required>
                    <option value="">-- Seleccione odontólogo --</option>
                    @if (odontologos != null)
                    {
                        foreach (var o in odontologos)
                        {
                            <option value="@o.IdUsuario">Dr. @o.ApellidoPaterno @o.Nombres</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Fecha *</label>
                <input type="date" name="FechaCita" id="inputFechaCita" class="form-control" required
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Hora *</label>
                <select name="HoraCita" id="selectHoraCita" class="form-select" required disabled>
                    <option value="">-- Seleccione primero una fecha --</option>
                </select>
                <small id="estadoSlots" class="text-muted"></small>
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <div id="feedbackCita" style="font-size: 0.9em;"></div>
            </div>

            <div class="col-12">
                <label class="form-label">Observaciones</label>
                <textarea name="Observaciones" class="form-control" rows="3" maxlength="500"></textarea>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success" id="btnAgendar">Agendar</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
        </div>
    }
</div>

@section Scripts {
    <script>
(function () {
    const selectOdontologo = document.getElementById('selectOdontologo');
    const inputFecha       = document.getElementById('inputFechaCita');
    const selectHora       = document.getElementById('selectHoraCita');
    const estadoSlots      = document.getElementById('estadoSlots');
    const feedback         = document.getElementById('feedbackCita');

    let fechasDisponibles = []; // fechas con disponibilidad del odontólogo

    // ─── PASO 1: Al cambiar odontólogo → cargar fechas disponibles ───
    selectOdontologo.addEventListener('change', function () {
        const idOdontologo = this.value;

        // Resetear fecha y hora
        inputFecha.value = '';
        inputFecha.disabled = true;
        selectHora.innerHTML = '<option value="">-- Seleccione primero una fecha --</option>';
        selectHora.disabled = true;
        estadoSlots.innerHTML = '';
        feedback.innerHTML = '';
        fechasDisponibles = [];

        if (!idOdontologo) return;

        feedback.innerHTML = '<span class="text-secondary">⏳ Cargando disponibilidad...</span>';

        fetch('@Url.Action("FechasDisponibles", "Citas")?idOdontologo=' + idOdontologo)
            .then(res => res.json())
            .then(fechas => {
                fechasDisponibles = fechas;
                feedback.innerHTML = '';

                if (fechas.length === 0) {
                    feedback.innerHTML = '<span class="text-warning">⚠️ Este odontólogo no tiene disponibilidad registrada en los próximos 60 días</span>';
                    inputFecha.disabled = true;
                    return;
                }

                // Habilitar el campo de fecha y configurar min/max
                inputFecha.disabled = false;
                inputFecha.min = fechas[0];
                inputFecha.max = fechas[fechas.length - 1];

                feedback.innerHTML = '<span class="text-success">✅ ' + fechas.length + ' día(s) con disponibilidad</span>';
            })
            .catch(() => {
                feedback.innerHTML = '<span class="text-danger">Error al cargar disponibilidad</span>';
            });
    });

    // ─── PASO 2: Al cambiar fecha → validar contra días disponibles y cargar slots ───
    inputFecha.addEventListener('change', function () {
        const fecha = this.value;
        selectHora.innerHTML = '<option value="">-- Cargando horarios... --</option>';
        selectHora.disabled = true;
        estadoSlots.innerHTML = '';

        if (!fecha) return;

        // Validar que el odontólogo tenga disponibilidad ese día
        if (fechasDisponibles.length > 0 && !fechasDisponibles.includes(fecha)) {
            estadoSlots.innerHTML = '<span class="text-danger">❌ El odontólogo no tiene disponibilidad este día. Selecciona otra fecha.</span>';
            selectHora.innerHTML = '<option value="">-- Sin disponibilidad --</option>';
            return;
        }

        const idOdontologo = selectOdontologo.value;
        const url = '@Url.Action("SlotsDisponibles", "Citas")?fecha=' + fecha +
                    (idOdontologo ? '&idOdontologo=' + idOdontologo : '');

        fetch(url)
            .then(res => res.json())
            .then(slots => {
                selectHora.innerHTML = '<option value="">-- Seleccione hora --</option>';
                const hoy = new Date(); hoy.setHours(0,0,0,0);
                const fechaSel = new Date(fecha + 'T00:00:00');
                const esHoy = fechaSel.getTime() === hoy.getTime();
                const horaActual = new Date();
                let disponibles = 0;

                slots.forEach(s => {
                    const [h, m] = s.hora.split(':').map(Number);
                    const horaSlot = new Date(fechaSel);
                    horaSlot.setHours(h, m, 0, 0);
                    const yaPaso = esHoy && horaSlot < horaActual;

                    const opt = document.createElement('option');
                    opt.value = s.hora;

                    if (yaPaso) {
                        opt.textContent = s.hora + ' — Hora pasada';
                        opt.disabled = true;
                    } else if (!s.disponible) {
                        opt.textContent = s.hora + ' — Ocupado';
                        opt.disabled = true;
                    } else {
                        opt.textContent = s.hora + ' — Libre';
                        disponibles++;
                    }
                    selectHora.appendChild(opt);
                });

                selectHora.disabled = false;
                estadoSlots.innerHTML = disponibles === 0
                    ? '<span class="text-danger">⚠️ No hay horarios disponibles este día</span>'
                    : '<span class="text-success">✅ ' + disponibles + ' horario(s) disponible(s)</span>';
            })
            .catch(() => {
                estadoSlots.innerHTML = '<span class="text-danger">Error al cargar horarios</span>';
                selectHora.innerHTML = '<option value="">-- Error --</option>';
            });
    });

    // Iniciar con fecha deshabilitada hasta que elijan odontólogo
    inputFecha.disabled = true;

    // ─── Validación antes de enviar ───────────────────────────────────
    document.querySelector('form').addEventListener('submit', function (e) {
        const fecha = inputFecha.value;
        const hora  = selectHora.value;
        if (!fecha || !hora) return;
        const fechaHora = new Date(fecha + 'T' + hora);
        if (fechaHora < new Date()) {
            e.preventDefault();
            feedback.innerHTML = '<span class="text-danger">❌ No se puede agendar en el pasado</span>';
        }
    });
})();
    </script>
}