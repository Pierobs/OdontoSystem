@model OdontoSystem.Entities.Usuario
@{
    ViewBag.Title = "Cambiar contraseña";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fa-solid fa-key"></i> Cambiar contraseña</h2>
        <a href="@Url.Action("Editar", new { id = Model.IdUsuario })" class="btn btn-secondary">← Volver</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-warning text-dark">
            <strong>Asignar nueva contraseña al usuario</strong>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <strong>Usuario:</strong> @Model.Nombres @Model.ApellidoPaterno @Model.ApellidoMaterno<br />
                <strong>Correo:</strong> @Model.CorreoInstitucional<br />
                <strong>Rol:</strong> @Model.Rol.Descripcion
            </div>

            <form action="@Url.Action("CambiarPassword", "Usuarios")" method="post" id="formPassword">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />

                <div class="mb-3">
                    <label class="form-label">Nueva contraseña *</label>
                    <div class="input-group">
                        <input type="password" name="NuevaPassword" id="inputPassword"
                               class="form-control" required minlength="6" maxlength="50" />
                        <button type="button" class="btn btn-outline-secondary" id="btnTogglePass">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <small class="text-muted">Mínimo 6 caracteres</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirmar nueva contraseña *</label>
                    <input type="password" id="inputConfirmar" class="form-control"
                           required minlength="6" maxlength="50" />
                    <small id="feedbackMatch" class="text-muted"></small>
                </div>

                <div class="alert alert-warning">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <strong>Importante:</strong> El usuario deberá iniciar sesión nuevamente con esta nueva contraseña.
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-warning" id="btnGuardar" disabled>
                        <i class="fa-solid fa-key"></i> Guardar nueva contraseña
                    </button>
                    <a href="@Url.Action("Editar", new { id = Model.IdUsuario })" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const inputPass = document.getElementById('inputPassword');
            const inputConf = document.getElementById('inputConfirmar');
            const feedback = document.getElementById('feedbackMatch');
            const btnGuardar = document.getElementById('btnGuardar');
            const btnToggle = document.getElementById('btnTogglePass');

            function validar() {
                const pass = inputPass.value;
                const conf = inputConf.value;

                if (pass.length < 6) {
                    feedback.innerHTML = '<span class="text-secondary">Mínimo 6 caracteres</span>';
                    btnGuardar.disabled = true;
                    return;
                }

                if (conf.length === 0) {
                    feedback.innerHTML = '';
                    btnGuardar.disabled = true;
                    return;
                }

                if (pass !== conf) {
                    feedback.innerHTML = '<span class="text-danger">❌ Las contraseñas no coinciden</span>';
                    btnGuardar.disabled = true;
                    return;
                }

                feedback.innerHTML = '<span class="text-success">✅ Las contraseñas coinciden</span>';
                btnGuardar.disabled = false;
            }

            inputPass.addEventListener('input', validar);
            inputConf.addEventListener('input', validar);

            btnToggle.addEventListener('click', function () {
                const tipo = inputPass.type === 'password' ? 'text' : 'password';
                inputPass.type = tipo;
                inputConf.type = tipo;
                this.querySelector('i').className = tipo === 'password' ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';
            });
        })();
    </script>
}