@model IEnumerable<OdontoSystem.Entities.Usuario>

@{
    ViewBag.Title = "Gestión de Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Usuarios</h2>
        <a href="@Url.Action("Crear")" class="btn btn-primary">+ Nuevo Usuario</a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped">
            <thead class="table-primary">
                <tr>
                    <th>#</th>
                    <th>Nombre Completo</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.IdUsuario</td>
                        <td>@u.ApellidoPaterno @u.ApellidoMaterno, @u.Nombres</td>
                        <td>@u.CorreoInstitucional</td>
                        <td><span class="badge bg-info">@u.Rol.Descripcion</span></td>
                        <td>
                            @if (u.Estado == "A")
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("Editar", new { id = u.IdUsuario })"
                               class="btn btn-sm btn-outline-primary">Editar</a>
                            <a href="@Url.Action("CambiarEstado", new { id = u.IdUsuario })"
                               class="btn btn-sm btn-outline-warning"
                               onclick="return confirm('¿Cambiar el estado de este usuario?');">
                                @(u.Estado == "A" ? "Desactivar" : "Activar")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No hay usuarios registrados.</div>
    }
</div>