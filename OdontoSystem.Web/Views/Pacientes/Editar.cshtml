@model OdontoSystem.Entities.Paciente

@{
    ViewBag.Title = "Editar paciente";
    var distritos = (IEnumerable<OdontoSystem.Entities.Distrito>)ViewBag.Distritos;
}

<div class="container mt-4">
    <h2><i class="fa-solid fa-user-pen"></i> Editar paciente</h2>
    <hr />

    @using (Html.BeginForm("Editar", "Pacientes", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
        @Html.HiddenFor(m => m.IdPaciente)
        @Html.HiddenFor(m => m.Estado)
        @Html.HiddenFor(m => m.FechaRegistro)

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Apellido Paterno *</label>
                <input name="ApellidoPaterno" id="inputApellidoPaterno" class="form-control" required maxlength="50"
                       value="@Model.ApellidoPaterno" readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">Apellido Materno *</label>
                <input name="ApellidoMaterno" id="inputApellidoMaterno" class="form-control" required maxlength="50"
                       value="@Model.ApellidoMaterno" readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label">Nombres *</label>
                <input name="Nombres" id="inputNombres" class="form-control" required maxlength="80"
                       value="@Model.Nombres" readonly />
            </div>

            <div class="col-md-3">
                <label class="form-label">Tipo de Documento *</label>
                <select name="IdTipoDocumento" class="form-select" required>
                    <option value="1" selected="@(Model.IdTipoDocumento == 1)">DNI</option>
                    <option value="2" selected="@(Model.IdTipoDocumento == 2)">Carnet de Extranjería</option>
                    <option value="3" selected="@(Model.IdTipoDocumento == 3)">Pasaporte</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">N° de Documento *</label>
                <div class="input-group">
                    <input name="NumeroDocumento" id="inputNumeroDocumento" class="form-control" required maxlength="20"
                           value="@Model.NumeroDocumento" />
                    <button type="button" id="btnValidarDni" class="btn btn-outline-secondary">Validar</button>
                </div>
                <div id="feedbackDni" class="mt-1" style="font-size: 0.85em;"></div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Sexo *</label>
                <select name="IdSexo" class="form-select" required>
                    <option value="1" selected="@(Model.IdSexo == 1)">Masculino</option>
                    <option value="2" selected="@(Model.IdSexo == 2)">Femenino</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha de Nacimiento</label>
                <input type="date" name="FechaNacimiento" class="form-control"
                       value="@(Model.FechaNacimiento?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Teléfono</label>
                <div class="input-group">
                    <input name="Telefono" id="inputTelefono" class="form-control"
                           maxlength="9" pattern="9[0-9]{8}"
                           placeholder=" " value="@Model.Telefono" />
                    <button type="button" id="btnValidarTelefono" class="btn btn-outline-secondary">Validar</button>
                </div>
                <div id="feedbackTelefono" class="mt-1" style="font-size: 0.85em;"></div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Correo</label>
                <input type="email" name="Correo" id="inputCorreo" class="form-control"
                       maxlength="254" placeholder="ejemplo@dominio.com"
                       value="@Model.Correo" />
                <div id="feedbackCorreo" class="mt-1" style="font-size: 0.85em;"></div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Distrito</label>
                <select name="IdDistrito" class="form-select">
                    <option value="">-- Seleccione distrito --</option>
                    @if (distritos != null)
                    {
                        foreach (var d in distritos)
                        {
                            if (Model.IdDistrito == d.IdDistrito)
                            {
                                <option value="@d.IdDistrito" selected>@d.Nombre (@d.Provincia)</option>
                            }
                            else
                            {
                                <option value="@d.IdDistrito">@d.Nombre (@d.Provincia)</option>
                            }
                        }
                    }
                </select>
            </div>

            <div class="col-12">
                <label class="form-label">Dirección</label>
                <input name="Direccion" class="form-control" maxlength="200"
                       value="@Model.Direccion" />
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">
                <i class="fa-solid fa-floppy-disk"></i> Actualizar
            </button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left"></i> Cancelar
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('inputCorreo');
            const feedback = document.getElementById('feedbackCorreo');
            let timeoutId = null;

            if (!input) return;

            input.addEventListener('input', function () {
                clearTimeout(timeoutId);
                feedback.innerHTML = '';
                const correo = this.value.trim();
                if (correo.length < 5) return;
                timeoutId = setTimeout(() => validar(correo), 500);
            });

            function validar(correo) {
                fetch('@Url.Action("ValidarCorreo", "Pacientes")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'correo=' + encodeURIComponent(correo)
                })
                .then(r => r.json())
                .then(data => mostrarResultado(data))
                .catch(() => { });
            }

            function mostrarResultado(data) {
                input.classList.remove('is-valid', 'is-invalid');
                if (!data.valido && data.sugerencia) {
                    input.classList.add('is-invalid');
                    feedback.innerHTML =
                        '<span class="text-warning">' +
                        '<i class="fa-solid fa-lightbulb"></i> ' + data.mensaje +
                        ' <a href="#" onclick="aceptarSugerencia(\'' + data.correoSugerido + '\'); return false;">' +
                        '<strong>Sí, corregir</strong></a></span>';
                }
                else if (!data.valido) {
                    input.classList.add('is-invalid');
                    feedback.innerHTML =
                        '<span class="text-danger"><i class="fa-solid fa-circle-xmark"></i> ' +
                        data.mensaje + '</span>';
                }
                else {
                    input.classList.add('is-valid');
                    feedback.innerHTML =
                        '<span class="text-success"><i class="fa-solid fa-circle-check"></i> Correo válido</span>';
                }
            }

            window.aceptarSugerencia = function (correo) {
                input.value = correo;
                input.dispatchEvent(new Event('input'));
            };
        })();
    </script>

    <script>
    // ─── Validación DNI RENIEC ──────────────────────────────
    (function () {
        const inputDni    = document.getElementById('inputNumeroDocumento');
        const selectTipo  = document.querySelector('select[name="IdTipoDocumento"]');
        const feedback    = document.getElementById('feedbackDni');
        const btnValidar  = document.getElementById('btnValidarDni');
        let dniValidado   = false;

        if (!inputDni || !btnValidar) return;

        function desbloquearCampos() {
            document.getElementById('inputApellidoPaterno').removeAttribute('readonly');
            document.getElementById('inputApellidoMaterno').removeAttribute('readonly');
            document.getElementById('inputNombres').removeAttribute('readonly');
        }

        function bloquearCampos() {
            document.getElementById('inputApellidoPaterno').setAttribute('readonly', true);
            document.getElementById('inputApellidoMaterno').setAttribute('readonly', true);
            document.getElementById('inputNombres').setAttribute('readonly', true);
        }

        // Si el usuario toca el DNI después de haberlo validado, resetear
        inputDni.addEventListener('input', function () {
            dniValidado = false;
            feedback.innerHTML = '';
            desbloquearCampos();
        });

        btnValidar.addEventListener('click', function () {
            if (selectTipo.value !== '1') {
                feedback.innerHTML = '<span class="text-secondary">Solo se valida DNI peruano.</span>';
                return;
            }

            const dni = inputDni.value.trim();

            if (dni.length !== 8 || isNaN(dni)) {
                feedback.innerHTML = '<span class="text-danger">❌ El DNI debe tener exactamente 8 dígitos</span>';
                return;
            }

            btnValidar.disabled = true;
            btnValidar.textContent = 'Validando...';
            feedback.innerHTML = '<span class="text-secondary">⏳ Consultando RENIEC...</span>';
            dniValidado = false;

            fetch('@Url.Action("ConsultarDni", "Pacientes")?dni=' + dni)
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    btnValidar.disabled = false;
                    btnValidar.textContent = 'Validar';
                    if (data.success) {
                        document.getElementById('inputApellidoPaterno').value = data.apPaterno;
                        document.getElementById('inputApellidoMaterno').value = data.apMaterno;
                        document.getElementById('inputNombres').value         = data.nombre;
                        feedback.innerHTML = '<span class="text-success">✅ DNI verificado en RENIEC</span>';
                        bloquearCampos();
                        dniValidado = true;
                    } else {
                        feedback.innerHTML = '<span class="text-danger">❌ ' + data.mensaje + '</span>';
                        desbloquearCampos();
                    }
                })
                .catch(function () {
                    btnValidar.disabled = false;
                    btnValidar.textContent = 'Validar';
                    feedback.innerHTML = '<span class="text-warning">⚠️ Sin conexión con RENIEC. Puede editar manualmente.</span>';
                    desbloquearCampos();
                });
        });

        // Bloquear submit si no se validó el DNI (solo para tipo DNI)
        document.querySelector('form').addEventListener('submit', function (e) {
            if (selectTipo.value === '1' && !dniValidado) {
                e.preventDefault();
                feedback.innerHTML = '<span class="text-danger">❌ Debes validar el DNI con RENIEC antes de guardar.</span>';
                inputDni.focus();
            }
        });

    })();
    </script>

    <script>
    // ─── Validación de teléfono ─────────────────────────────
    (function () {
        const inputTel   = document.getElementById('inputTelefono');
        const feedback   = document.getElementById('feedbackTelefono');
        const btnValidar = document.getElementById('btnValidarTelefono');

        if (!inputTel || !btnValidar) return;

        inputTel.addEventListener('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 9);
            feedback.innerHTML = '';

            const tel = this.value;
            if (tel.length === 0) return;

            if (tel.length < 9) {
                feedback.innerHTML = '<span class="text-secondary">⏳ Faltan ' + (9 - tel.length) + ' dígitos</span>';
                return;
            }

            if (!/^9\d{8}$/.test(tel)) {
                feedback.innerHTML = '<span class="text-danger">❌ Debe empezar con 9 (ej: 987654321)</span>';
                return;
            }

            feedback.innerHTML = '<span class="text-muted">Formato correcto. Clic en "Validar" para verificar con el operador.</span>';
        });

        btnValidar.addEventListener('click', function () {
            const tel = inputTel.value;

            if (!/^9\d{8}$/.test(tel)) {
                feedback.innerHTML = '<span class="text-danger">❌ Debe empezar con 9 y tener 9 dígitos</span>';
                return;
            }

            btnValidar.disabled = true;
            btnValidar.textContent = 'Validando...';
            feedback.innerHTML = '<span class="text-secondary">⏳ Verificando número...</span>';

            fetch('@Url.Action("ValidarTelefono", "Pacientes")?telefono=' + tel)
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    btnValidar.disabled = false;
                    btnValidar.textContent = 'Validar';

                    if (data.valido) {
                        feedback.innerHTML = '<span class="text-success">✅ Número válido' +
                            (data.operadora ? ' — Operador: ' + data.operadora : '') + '</span>';
                    } else {
                        feedback.innerHTML = '<span class="text-warning">⚠️ ' + data.mensaje + '</span>';
                    }
                })
                .catch(function () {
                    btnValidar.disabled = false;
                    btnValidar.textContent = 'Validar';
                    feedback.innerHTML = '<span class="text-danger">❌ Error al validar. Intenta de nuevo.</span>';
                });
        });
    })();
    </script>

}