@model IEnumerable<OdontoSystem.Entities.Paciente>

@{
    ViewBag.Title = "Pacientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-people"></i> Pacientes registrados</h2>
        <a href="@Url.Action("Crear")" class="btn btn-primary">
            + Nuevo paciente
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="get" action="@Url.Action("Buscar")" class="mb-3">
        <div class="input-group">
            <input type="text" name="criterio" class="form-control"
                   placeholder="Buscar por nombre, apellido o documento..." />
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-primary">
                <tr>
                    <th>#</th>
                    <th>Apellidos y Nombres</th>
                    <th>Documento</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.IdPaciente</td>
                        <td>@p.ApellidoPaterno @p.ApellidoMaterno, @p.Nombres</td>
                        <td>@p.NumeroDocumento</td>
                        <td>@p.Telefono</td>
                        <td>
                            @if (p.Estado == "A")
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("Editar", new { id = p.IdPaciente })"
                               class="btn btn-sm btn-outline-primary"
                               title="Editar paciente">
                                <i class="fa-solid fa-pen"></i> Editar
                            </a>
                            <a href="@Url.Action("CambiarEstado", new { id = p.IdPaciente })"
                               class="btn btn-sm @(p.Estado == "A" ? "btn-outline-danger" : "btn-outline-success")"
                               onclick="return confirm('@(p.Estado == "A" ? "¿Desactivar este paciente?" : "¿Reactivar este paciente?")');"
                               title="@(p.Estado == "A" ? "Desactivar paciente" : "Reactivar paciente")">
                                <i class="fa-solid @(p.Estado == "A" ? "fa-user-slash" : "fa-user-check")"></i>
                                @(p.Estado == "A" ? "Desactivar" : "Activar")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No hay pacientes registrados. <a href="@Url.Action("Crear")">Registre el primero</a>.
        </div>
    }
</div>