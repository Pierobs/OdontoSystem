@model IEnumerable<OdontoSystem.Entities.Paciente>
@{
    ViewBag.Title = "Pacientes";
}
<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <div>
            <h2 class="mb-0"><i class="fa-solid fa-users text-muted me-1" style="font-size:.85em;"></i> Pacientes</h2>
            <p class="text-muted mb-0 small">Registro de pacientes del consultorio.</p>
        </div>
        <a href="@Url.Action("Crear")" class="btn btn-primary">
            <i class="fa-solid fa-user-plus me-1"></i> Nuevo paciente
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mt-3">
        <div class="card-body">
            <form method="get" action="@Url.Action("Buscar")" class="mb-3">
                <div class="input-group" style="max-width:420px;">
                    <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="criterio" class="form-control border-start-0 ps-0"
                           placeholder="Buscar por nombre, apellido o documento..." />
                    <button type="submit" class="btn btn-outline-primary">Buscar</button>
                </div>
            </form>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>N°</th>
                                <th>Paciente</th>
                                <th>Documento</th>
                                <th>Teléfono</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int contador = 0; }
                            @foreach (var p in Model)
                            {
                                contador++;
                                <tr>
                                    <td class="num text-muted">@contador</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="avatar-circle">@p.Nombres.Substring(0, 1)@p.ApellidoPaterno.Substring(0, 1)</span>
                                            <span>@p.ApellidoPaterno @p.ApellidoMaterno, @p.Nombres</span>
                                        </div>
                                    </td>
                                    <td class="num">@p.NumeroDocumento</td>
                                    <td class="num">@p.Telefono</td>
                                    <td>
                                        @if (p.Estado == "A")
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Editar", new { id = p.IdPaciente })"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Editar paciente">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <a href="@Url.Action("Index", "Planes", new { idPaciente = p.IdPaciente })"
                                           class="btn btn-sm btn-outline-info"
                                           title="Ver planes de tratamiento">
                                            <i class="fa-solid fa-clipboard-list"></i>
                                        </a>
                                        <a href="@Url.Action("VerPaciente", "Odontograma", new { idPaciente = p.IdPaciente })"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Ver odontograma actual">
                                            <i class="fa-solid fa-tooth"></i>
                                        </a>
                                        <a href="@Url.Action("CambiarEstado", new { id = p.IdPaciente })"
                                           class="btn btn-sm @(p.Estado == "A" ? "btn-outline-danger" : "btn-outline-success")"
                                           onclick="return confirm('@(p.Estado == "A" ? "¿Desactivar este paciente?" : "¿Reactivar este paciente?")');"
                                           title="@(p.Estado == "A" ? "Desactivar paciente" : "Reactivar paciente")">
                                            <i class="fa-solid @(p.Estado == "A" ? "fa-user-slash" : "fa-user-check")"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No hay pacientes registrados. <a href="@Url.Action("Crear")">Registre el primero</a>.
                </div>
            }
        </div>
    </div>
</div>
