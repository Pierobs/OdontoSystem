@{
    ViewBag.Title = "Nuevo Plan de Tratamiento";
    var pacientes = ViewBag.Pacientes as IEnumerable<OdontoSystem.Entities.Paciente>;
    var tratamientos = ViewBag.Tratamientos as IEnumerable<OdontoSystem.Entities.CatalogoTratamiento>;
    int? idPacienteSel = ViewBag.IdPacienteSeleccionado as int?;
}

<div class="container mt-4">
    <h2>Nuevo Plan de Tratamiento</h2>
    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @using (Html.BeginForm("Crear", "Planes", FormMethod.Post, new { id = "formPlan" }))
    {
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Paciente *</label>
                <select name="idPaciente" class="form-select" required>
                    <option value="">-- Seleccione paciente --</option>
                    @if (pacientes != null)
                    {
                        foreach (var p in pacientes)
                        {
                            <option value="@p.IdPaciente" selected="@(idPacienteSel == p.IdPaciente)">
                                @p.ApellidoPaterno @p.ApellidoMaterno, @p.Nombres
                            </option>
                        }
                    }
                </select>
            </div>
        </div>

        <h4 class="mt-4">Tratamientos del Plan</h4>
        <div id="lineasContainer">
            @* Filas dinámicas de tratamientos *@
        </div>

        <button type="button" id="btnAgregarLinea" class="btn btn-outline-primary mt-2">
            <i class="fa-solid fa-plus"></i> Agregar procedimiento
        </button>

        <div class="row mt-4">
            <div class="col-md-4 offset-md-8">
                <div class="card">
                    <div class="card-body text-end">
                        <h5>Total: <span id="montoTotal">S/. 0.00</span></h5>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">Crear Plan</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
        </div>
    }
</div>

@section Scripts {
    <script>
    const tratamientos = [
        @foreach (var t in tratamientos)
        {
            <text>{ id: @t.IdTratamiento, nombre: '@Html.Raw(t.Nombre.Replace("'", "\\'"))', precio: @t.PrecioBase.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) },</text>
        }
    ];

    const container  = document.getElementById('lineasContainer');
    const btnAgregar = document.getElementById('btnAgregarLinea');
    const totalSpan  = document.getElementById('montoTotal');

    function crearLinea(tratamientoId, tratamientoNombre, precio) {
        const div = document.createElement('div');
        div.className = 'card mb-2 linea-tratamiento border-0 shadow-sm';

        const opciones = tratamientos.map(t =>
            '<option value="' + t.id + '" data-precio="' + t.precio + '"' +
            (t.id == tratamientoId ? ' selected' : '') + '>' +
            t.nombre + ' (S/. ' + t.precio + ')</option>'
        ).join('');

        div.innerHTML =
            '<div class="card-body py-2">' +
                '<div class="row g-2 align-items-end">' +
                    '<div class="col-md-4">' +
                        '<label class="form-label mb-1" style="font-size:0.82em;">Tratamiento *</label>' +
                        '<select name="idTratamiento" class="form-select form-select-sm select-tratamiento" required>' +
                            '<option value="">-- Seleccione --</option>' + opciones +
                        '</select>' +
                    '</div>' +
                    '<div class="col-md-2">' +
                        '<label class="form-label mb-1" style="font-size:0.82em;"><i class="fa-solid fa-tooth"></i> Pieza FDI</label>' +
                        '<input type="number" name="numeroPieza" class="form-control form-control-sm" min="11" max="85" placeholder="Ej: 47" />' +
                    '</div>' +
                    '<div class="col-md-2">' +
                        '<label class="form-label mb-1" style="font-size:0.82em;">Superficie</label>' +
                        '<select name="superficie" class="form-select form-select-sm">' +
                            '<option value="">-- General --</option>' +
                            '<option value="Vestibular">Vestibular</option>' +
                            '<option value="Oclusal">Oclusal</option>' +
                            '<option value="Lingual">Lingual</option>' +
                            '<option value="Mesial">Mesial</option>' +
                            '<option value="Distal">Distal</option>' +
                            '<option value="Completo">Completo</option>' +
                        '</select>' +
                    '</div>' +
                    '<div class="col-md-2">' +
                        '<label class="form-label mb-1" style="font-size:0.82em;">Precio *</label>' +
                        '<input type="number" name="precioUnitario" class="form-control form-control-sm input-precio" step="0.01" min="0" required />' +
                        '<input type="hidden" name="cantidad" value="1" />' +
                        '<input type="hidden" name="estadoTratamiento" value="Pendiente" />' +
                    '</div>' +
                    '<div class="col-md-2 d-flex gap-1">' +
                        '<button type="button" class="btn btn-sm btn-outline-secondary btn-duplicar" title="Duplicar para otra pieza">' +
                            '<i class="fa-solid fa-copy"></i>' +
                        '</button>' +
                        '<button type="button" class="btn btn-sm btn-outline-danger btn-quitar">' +
                            '<i class="fa-solid fa-xmark"></i>' +
                        '</button>' +
                    '</div>' +
                '</div>' +
            '</div>';

        container.appendChild(div);

        const selectTrat  = div.querySelector('.select-tratamiento');
        const inputPrecio = div.querySelector('.input-precio');
        const btnQuitar   = div.querySelector('.btn-quitar');
        const btnDuplicar = div.querySelector('.btn-duplicar');

        if (precio) inputPrecio.value = precio;

        selectTrat.addEventListener('change', function () {
            const opt = this.options[this.selectedIndex];
            inputPrecio.value = opt.dataset.precio || '';
            actualizarTotal();
        });

        inputPrecio.addEventListener('input', actualizarTotal);

        btnQuitar.addEventListener('click', function () {
            div.remove();
            actualizarTotal();
        });

        btnDuplicar.addEventListener('click', function () {
            const tId    = selectTrat.value;
            const tPrecio = inputPrecio.value;
            crearLinea(tId, null, tPrecio);
        });
    }

    function actualizarTotal() {
        let total = 0;
        document.querySelectorAll('.linea-tratamiento').forEach(function (linea) {
            const precio = parseFloat(linea.querySelector('.input-precio')?.value) || 0;
            total += precio;
        });
        totalSpan.textContent = 'S/. ' + total.toFixed(2);
    }

    btnAgregar.addEventListener('click', function () { crearLinea(); });

    // Primera línea por defecto
    crearLinea();

    // Validar antes de enviar
    document.getElementById('formPlan').addEventListener('submit', function (e) {
        const lineas = document.querySelectorAll('.linea-tratamiento');
        if (lineas.length === 0) {
            e.preventDefault();
            alert('Debe agregar al menos un procedimiento al plan');
        }
    });
    </script>
}