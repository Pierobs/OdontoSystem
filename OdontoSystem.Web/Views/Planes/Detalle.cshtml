@model OdontoSystem.Entities.PlanTratamiento
@{
    ViewBag.Title = "Detalle del Plan";
    var evoluciones = ViewBag.Evoluciones as IEnumerable<OdontoSystem.BLL.Services.EvolucionService.EvolucionDto>;
    var citasAtendidas = ViewBag.CitasAtendidas as IEnumerable<OdontoSystem.Entities.Cita>;
    var pagos = ViewBag.Pagos as IEnumerable<OdontoSystem.BLL.Services.PagoService.PagoDto>;
    var metodosPago = ViewBag.MetodosPago as string[];
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Plan de Tratamiento</h2>
        <a href="@Url.Action("Index")" class="btn btn-secondary">← Volver</a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <strong>Información del Plan</strong>
                </div>
                <div class="card-body">
                    <p><strong>Paciente:</strong> @Model.Paciente.Nombres @Model.Paciente.ApellidoPaterno @Model.Paciente.ApellidoMaterno</p>
                    <p><strong>Documento:</strong> @Model.Paciente.NumeroDocumento</p>
                    <p><strong>Fecha creación:</strong> @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
                    <p>
                        <strong>Estado:</strong>
                        @switch (Model.Estado)
                        {
                            case "Activo":<span class="badge bg-warning text-dark">Activo</span> break;
                            case "Pagado": <span class="badge bg-success">Pagado</span> break;
                            case "Cancelado":<span class="badge bg-danger">Cancelado</span>break;
                        }
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header bg-info text-white">
                    <strong>Resumen Financiero</strong>
                </div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <tr><td>Monto Total:</td>    <td class="text-end"><strong>S/. @Model.MontoTotal.ToString("N2")</strong></td></tr>
                        <tr><td>Abonado:</td>         <td class="text-end text-success">S/. @Model.MontoAbonado.ToString("N2")</td></tr>
                        <tr><td>Saldo Pendiente:</td> <td class="text-end text-danger"><strong>S/. @Model.Saldo.ToString("N2")</strong></td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <strong>Tratamientos incluidos</strong>
            @if (Model.Estado == "Activo")
            {
                <button type="button" class="btn btn-sm btn-light"
                        data-bs-toggle="modal" data-bs-target="#modalAgregar">
                    <i class="fa-solid fa-plus"></i> Agregar tratamiento
                </button>
            }
        </div>
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Tratamiento</th>
                        <th class="text-center">Pieza</th>
                        <th class="text-center">Superficie</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Precio</th>
                        <th class="text-end">Subtotal</th>
                        @if (Model.Estado == "Activo")
                        {
                            <th class="text-center">Sesiones</th>
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{
                        int contador = 0;
                        string badgeColor = "bg-secondary";
                        int sesiones = 0;
                    }
                    @foreach (var d in Model.Detalles)
                    {
                        contador++;
                        switch (d.EstadoTratamiento)
                        {
                            case "Completado": badgeColor = "bg-success"; break;
                            case "EnProceso": badgeColor = "bg-warning text-dark"; break;
                            case "Cancelado": badgeColor = "bg-danger"; break;
                            default: badgeColor = "bg-secondary"; break;
                        }
                        sesiones = evoluciones != null
                            ? evoluciones.Count(e => e.IdPlanDetalle == d.IdPlanDetalle)
                            : 0;
                        <tr>
                            <td>@contador</td>
                            <td>@d.Tratamiento.Nombre</td>
                            <td class="text-center">
                                @(d.NumeroPieza.HasValue ? d.NumeroPieza.ToString() : "—")
                            </td>
                            <td class="text-center">
                                @(string.IsNullOrEmpty(d.Superficie) ? "—" : d.Superficie)
                            </td>
                            <td class="text-center">
                                <span class="badge @badgeColor">
                                    @(d.EstadoTratamiento ?? "Pendiente")
                                </span>
                            </td>
                            <td class="text-center">S/. @d.PrecioUnitario.ToString("N2")</td>
                            <td class="text-end">S/. @d.Subtotal.ToString("N2")</td>
                            @if (Model.Estado == "Activo")
                            {
                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEvolucion-@d.IdPlanDetalle"
                                            title="Registrar sesión de trabajo">
                                        <i class="fa-solid fa-notes-medical"></i>
                                        @if (sesiones > 0)
                                        {
                                            <span class="badge bg-primary ms-1">@sesiones</span>
                                        }
                                    </button>
                                </td>
                                <td>
                                    <form action="@Url.Action("QuitarDetalle", "Planes")" method="post"
                                          onsubmit="return confirm('¿Quitar este tratamiento del plan?');"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idPlanDetalle" value="@d.IdPlanDetalle" />
                                        <input type="hidden" name="idPlan" value="@Model.IdPlan" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Estado == "Activo")
    {
        <div class="d-flex gap-2 mb-4">
            @if (Model.Saldo == 0)
            {
                <form action="@Url.Action("Cerrar", "Planes")" method="post"
                      onsubmit="return confirm('¿Cerrar este plan como pagado?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.IdPlan" />
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-check"></i> Cerrar plan (pagado)
                    </button>
                </form>
            }
            <form action="@Url.Action("Cancelar", "Planes")" method="post"
                  onsubmit="return confirm('¿Cancelar este plan? Esta acción no se puede deshacer.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.IdPlan" />
                <button type="submit" class="btn btn-outline-danger">
                    <i class="fa-solid fa-ban"></i> Cancelar plan
                </button>
            </form>
        </div>
    }

    @* Registrar pago *@
    @if (Model.Estado == "Activo" && Model.Saldo > 0)
    {
        <div class="card mb-3 border-success">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <strong><i class="fa-solid fa-money-bill-wave"></i> Registrar Pago</strong>
                <small>Saldo pendiente: <strong>S/. @Model.Saldo.ToString("N2")</strong></small>
            </div>
            <div class="card-body">
                <form action="@Url.Action("Registrar", "Pagos")" method="post"
                      class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idPlan" value="@Model.IdPlan" />
                    <div class="col-md-3">
                        <label class="form-label">Monto (S/.) *</label>
                        <input type="number" name="monto" class="form-control"
                               step="0.01" min="0.01"
                               max="@Model.Saldo.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                               placeholder="0.00" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Método de pago *</label>
                        <select name="metodoPago" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                            @if (metodosPago != null)
                            {
                                foreach (var m in metodosPago)
                                {
                                    <option value="@m">@m</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-outline-success w-100"
                                onclick="document.querySelector('input[name=monto]').value='@Model.Saldo.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)'">
                            Pagar saldo completo
                        </button>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fa-solid fa-check"></i> Registrar pago
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @* Historial de pagos *@
    @if (pagos != null && pagos.Any())
    {
        <div class="card mb-3">
            <div class="card-header bg-success text-white">
                <strong><i class="fa-solid fa-receipt"></i> Historial de pagos</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Método</th>
                            <th class="text-end">Monto</th>
                            <th>Registrado por</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in pagos)
                        {
                            <tr>
                                <td class="text-nowrap">@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @{
                                        string iconoPago;
                                        switch (p.MetodoPago)
                                        {
                                            case "Efectivo": iconoPago = "fa-money-bill-wave"; break;
                                            case "Tarjeta": iconoPago = "fa-credit-card"; break;
                                            case "Transferencia": iconoPago = "fa-building-columns"; break;
                                            case "Yape": iconoPago = "fa-mobile-screen"; break;
                                            case "Plin": iconoPago = "fa-mobile-screen"; break;
                                            default: iconoPago = "fa-circle-dollar-to-slot"; break;
                                        }
                                    }
                                    <i class="fa-solid @iconoPago me-1"></i>@p.MetodoPago
                                </td>
                                <td class="text-end text-success fw-bold">S/. @p.Monto.ToString("N2")</td>
                                <td>@p.NombresUsuario @p.ApellidoUsuario</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="2"><strong>Total abonado</strong></td>
                            <td class="text-end"><strong>S/. @Model.MontoAbonado.ToString("N2")</strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }

    @* Historial de sesiones *@
    @if (evoluciones != null && evoluciones.Any())
    {
        <div class="card mb-3">
            <div class="card-header bg-dark text-white">
                <strong><i class="fa-solid fa-clock-rotate-left"></i> Historial de sesiones</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tratamiento</th>
                            <th class="text-center">Pieza</th>
                            <th class="text-center">Superficie</th>
                            <th>Odontólogo</th>
                            <th>Descripción</th>
                            <th class="text-center">Cita</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in evoluciones)
                        {
                            <tr>
                                <td class="text-nowrap">@ev.FechaEvolucion.ToString("dd/MM/yyyy")</td>
                                <td>@ev.NombreTratamiento</td>
                                <td class="text-center">@(ev.NumeroPieza.HasValue ? ev.NumeroPieza.ToString() : "—")</td>
                                <td class="text-center">@(string.IsNullOrEmpty(ev.Superficie) ? "—" : ev.Superficie)</td>
                                <td>Dr. @ev.ApellidoOdontologo</td>
                                <td>@ev.Descripcion</td>
                                <td class="text-center">
                                    @if (ev.IdCita.HasValue)
                                    {
                                        <span class="badge bg-info">Cita #@ev.IdCita</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Modales de evolución por tratamiento *@
    @if (Model.Estado == "Activo")
    {
        foreach (var d in Model.Detalles)
        {
            <div class="modal fade" id="modalEvolucion-@d.IdPlanDetalle" tabindex="-1">
                <div class="modal-dialog">
                    <form action="@Url.Action("Registrar", "Evoluciones")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idPlan" value="@Model.IdPlan" />
                        <input type="hidden" name="idTratamiento" value="@d.IdTratamiento" />
                        <input type="hidden" name="idPlanDetalle" value="@d.IdPlanDetalle" />
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">
                                    <i class="fa-solid fa-notes-medical"></i>
                                    Registrar sesión — @d.Tratamiento.Nombre
                                    @if (d.NumeroPieza.HasValue)
                                    {
                                        <small class="ms-1 opacity-75">| Pieza @d.NumeroPieza @d.Superficie</small>
                                    }
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">Fecha de la sesión *</label>
                                    <input type="date" name="fechaEvolucion" class="form-control"
                                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Descripción de lo realizado *</label>
                                    <textarea name="descripcion" class="form-control" rows="3"
                                              maxlength="1000" required
                                              placeholder="Ej: Se realizó preparación cavitaria y obturación con resina..."></textarea>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Vincular a una cita (opcional)</label>
                                    <select name="idCita" class="form-select">
                                        <option value="">-- Sin cita asociada --</option>
                                        @if (citasAtendidas != null)
                                        {
                                            foreach (var cita in citasAtendidas)
                                            {
                                                <option value="@cita.IdCita">
                                                    Cita #@cita.IdCita — @cita.FechaCita.ToString("dd/MM/yyyy") @cita.HoraCita.ToString(@"hh\:mm")
                                                </option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Actualizar estado del tratamiento</label>
                                    <select name="nuevoEstadoTratamiento" class="form-select">
                                        <option value="Pendiente" @(d.EstadoTratamiento == "Pendiente" || d.EstadoTratamiento == null ? "selected" : "")>Pendiente (sin cambio)</option>
                                        <option value="EnProceso" @(d.EstadoTratamiento == "EnProceso" ? "selected" : "")>En proceso</option>
                                        <option value="Completado" @(d.EstadoTratamiento == "Completado" ? "selected" : "")>Completado ✓</option>
                                        <option value="Cancelado" @(d.EstadoTratamiento == "Cancelado" ? "selected" : "")>Cancelado</option>
                                    </select>
                                    <small class="text-muted">El odontólogo decide si el tratamiento avanzó de estado en esta sesión.</small>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa-solid fa-save"></i> Guardar sesión
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    }

    @* Modal Agregar tratamiento *@
    <div class="modal fade" id="modalAgregar" tabindex="-1">
        <div class="modal-dialog">
            <form action="@Url.Action("AgregarDetalle", "Planes")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idPlan" value="@Model.IdPlan" />
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">Agregar Tratamiento</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Tratamiento *</label>
                            <select name="idTratamiento" id="modalSelectTrat" class="form-select" required>
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>
                        <input type="hidden" name="cantidad" value="1" />
                        <input type="hidden" name="estadoTratamiento" value="Pendiente" />
                        <div class="mb-3">
                            <label class="form-label">Precio Unit. *</label>
                            <input type="number" name="precioUnitario" id="modalInputPrecio"
                                   class="form-control" step="0.01" min="0" required />
                        </div>
                        <hr class="my-2" />
                        <p class="text-muted mb-2" style="font-size:0.85em;">
                            <i class="fa-solid fa-tooth"></i>
                            Opcional: vincula este procedimiento a una pieza dental específica
                        </p>
                        <div class="row g-2">
                            <div class="col-5">
                                <label class="form-label">Pieza FDI</label>
                                <input type="number" name="numeroPieza" class="form-control"
                                       min="11" max="85" placeholder="Ej: 47 (opcional)" />
                                <small class="text-muted">11–28 superior / 31–48 inferior</small>
                            </div>
                            <div class="col-7">
                                <label class="form-label">Superficie</label>
                                <select name="superficie" class="form-select">
                                    <option value="">-- General (toda la pieza) --</option>
                                    <option value="Vestibular">Vestibular</option>
                                    <option value="Oclusal">Oclusal</option>
                                    <option value="Lingual">Lingual</option>
                                    <option value="Mesial">Mesial</option>
                                    <option value="Distal">Distal</option>
                                    <option value="Completo">Completo</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Volver</button>
                        <button type="submit" class="btn btn-primary">Agregar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const select = document.getElementById('modalSelectTrat');
        const inputPrecio = document.getElementById('modalInputPrecio');
        if (!select) return;

        const tratamientos = [
            @{
                var cat = new OdontoSystem.BLL.Services.CatalogoTratamientoService().Listar(soloActivos: true);
                foreach (var t in cat)
                {
                    <text>{ id: @t.IdTratamiento, nombre: '@Html.Raw(t.Nombre.Replace("'", "\\'"))', precio: @t.PrecioBase.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) },</text>
                }
            }
        ];

        tratamientos.forEach(function (t) {
            const opt = document.createElement('option');
            opt.value = t.id;
            opt.textContent = t.nombre + ' (S/. ' + t.precio + ')';
            opt.dataset.precio = t.precio;
            select.appendChild(opt);
        });

        select.addEventListener('change', function () {
            const opt = this.options[this.selectedIndex];
            inputPrecio.value = opt.dataset.precio || '';
        });
    });
    </script>
}